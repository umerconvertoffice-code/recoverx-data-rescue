# Create a Supabase project and set these values in your local .env file.
# Never put a Supabase service-role key in the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://umerconvertoffice-code.github.io/recoverx-data-rescue

# Admin privileges must be assigned through trusted Supabase app metadata.
VITE_SUPPORT_EMAIL=support@recoverx.com
